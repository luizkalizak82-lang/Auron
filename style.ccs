/* =================================
   AURON - INTERFACE FUTURISTA
   ================================= */

:root {
    --background: #050505;
    --green: #00ff88;
    --green-dark: #008f50;
    --text: #ffffff;
    --muted: #929a95;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    min-height: 100%;
    background: var(--background);
}

body {
    min-height: 100vh;
    min-height: 100dvh;

    background:
        radial-gradient(
            ellipse at 50% 42%,
            rgba(0, 255, 136, 0.08),
            transparent 45%
        ),
        var(--background);

    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont,
        "Segoe UI", Arial, sans-serif;

    overflow-x: hidden;
}

.container {
    width: 100%;
    max-width: 520px;
    min-height: 100vh;
    min-height: 100dvh;

    margin: 0 auto;
    padding: 48px 24px 28px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
}

.header {
    text-align: center;
}

.header h1 {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: 12px;
    padding-left: 12px;

    text-shadow:
        0 0 18px rgba(0, 255, 136, 0.35);
}

.subtitle {
    margin-top: 12px;

    color: var(--muted);
    font-size: 11px;
    letter-spacing: 4px;
}

/* ÁREA PRINCIPAL */

.assistant {
    width: 100%;

    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;
}

/* ESFERA */

.orb-container {
    width: 230px;
    height: 230px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 30px;
}

.orb {
    width: 170px;
    height: 170px;

    position: relative;
    overflow: hidden;

    border-radius: 50%;

    background:
        radial-gradient(
            circle at 32% 25%,
            #e2fff0 0%,
            #83ffc0 7%,
            #18ff8a 20%,
            #00b95f 43%,
            #00652f 68%,
            #00180b 100%
        );

    box-shadow:
        0 0 22px rgba(0, 255, 136, 0.55),
        0 0 55px rgba(0,
